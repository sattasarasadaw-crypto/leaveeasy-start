// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎขั้นต่ำของสัปดาห์ที่ 7 (leaveeasy-spec.md หัวข้อ 0.2)
// ต้องล็อกอินก่อน ถึงจะอ่าน/เขียนได้ — ยังไม่แยกสิทธิ์รายบทบาท (นั่นคือสัปดาห์ที่ 8)
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
